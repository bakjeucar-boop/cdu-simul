# 가상환경
.venv/

# 파이썬 캐시
__pycache__/
*.pyc
*.pyo
*.pyd

# 패키징/테스트 산출물
*.egg-info/
build/
dist/
.pytest_cache/

# 시뮬레이션 결과물 (데이터셋·로그)
results/
data/
*.csv
*.parquet

# 예외 — `docs/` 의 짝 목록은 **추적본이어야 한다** (세션 7.77 · 미해결 #84).
# 남기는 자리를 `results/` 가 아니라 `docs/` 로 고른 까닭이 「다른 PC 로 간다」
# 하나인데, 위 `*.csv` 가 그것까지 덮고 있었다.
!docs/*.csv

# 사람이 쓰는 명령어 메모 (커밋도 백업도 하지 않는다 · 세션 7.25)
start-cdu.txt
